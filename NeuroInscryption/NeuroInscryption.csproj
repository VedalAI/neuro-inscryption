<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>preview</LangVersion>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);CS0436</NoWarn>

        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>

        <Nullable>enable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.700" />
        <PackageReference Include="Inscryption.GameLibs" Version="1.9.0-r.0" Publicize="true" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="TwitchLib" Version="3.5.3" />
        <PackageReference Include="UnityEngine.Modules" Version="2019.4.24" />
        <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
        <Reference Include="Resources/Assemblies/UniTask.dll" />

        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" Aliases="JetBrains" PrivateAssets="all" />
        <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources/**" />
        <EmbeddedResource Remove="Resources/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Automation\**" />
        <Compile Remove="Input\**" />
        <Compile Remove="Communication\Actions\**" />
        <Compile Remove="Communication\Messages\Incoming\Action.cs" />
        <Compile Remove="Communication\Messages\Outgoing\Decision.cs" />
        <Compile Remove="Configuration\ChallengeFlags.cs" />
        <Compile Remove="Configuration\StarterDeckOption.cs" />
        <Compile Remove="Configuration\ModConfig.Neuro.cs" />
        <Compile Remove="Tweaks\InfoUI.cs" />
        <Compile Remove="Tweaks\RedirectSaveFile.cs" />
        <Compile Remove="Tweaks\UnlockAllChallengesAndDecks.cs" />
        <Compile Remove="Tweaks\UnlockKayceesMod.cs" />
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(Inscryption)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Inscryption)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>

</Project>
